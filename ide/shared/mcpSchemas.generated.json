{
  "json_format": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      },
      "indent": {
        "description": "Indent spaces (default 2).",
        "type": "number"
      }
    },
    "required": [
      "text"
    ]
  },
  "json_validate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    },
    "required": [
      "text"
    ]
  },
  "base64_encode": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    },
    "required": [
      "text"
    ]
  },
  "base64_decode": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    },
    "required": [
      "text"
    ]
  },
  "url_encode": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    },
    "required": [
      "text"
    ]
  },
  "url_decode": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    },
    "required": [
      "text"
    ]
  },
  "uuid_generate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "count": {
        "description": "How many to generate (default 1, max 100).",
        "type": "number"
      }
    }
  },
  "jwt_decode": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "token": {
        "type": "string",
        "description": "The JWT string."
      }
    },
    "required": [
      "token"
    ]
  },
  "hash": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      },
      "algorithm": {
        "type": "string",
        "enum": [
          "md5",
          "sha1",
          "sha256",
          "sha384",
          "sha512"
        ],
        "description": "md5, sha1, sha256, sha384, or sha512"
      }
    },
    "required": [
      "text",
      "algorithm"
    ]
  },
  "hmac": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "message": {
        "type": "string",
        "description": "The message or raw request body to sign."
      },
      "key": {
        "type": "string",
        "description": "The secret key."
      },
      "algorithm": {
        "description": "Hash function (default SHA-256). Webhook presets always use SHA-256.",
        "type": "string",
        "enum": [
          "SHA-256",
          "SHA-1",
          "SHA-384",
          "SHA-512"
        ]
      },
      "key_encoding": {
        "description": "How the key is written (default utf8).",
        "type": "string",
        "enum": [
          "utf8",
          "hex",
          "base64"
        ]
      },
      "message_encoding": {
        "description": "How the message is written (default utf8). Ignored for webhook presets.",
        "type": "string",
        "enum": [
          "utf8",
          "hex",
          "base64"
        ]
      },
      "preset": {
        "description": "plain (default), github (X-Hub-Signature-256), stripe (t.payload) or slack (v0:ts:body).",
        "type": "string",
        "enum": [
          "plain",
          "github",
          "stripe",
          "slack"
        ]
      },
      "timestamp": {
        "description": "Unix timestamp used by the stripe and slack presets.",
        "type": "string"
      },
      "expected": {
        "description": "Optional signature to verify, in hex or Base64, with or without a sha256= / v0= / v1= prefix.",
        "type": "string"
      }
    },
    "required": [
      "message",
      "key"
    ]
  },
  "case_convert": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      },
      "style": {
        "type": "string",
        "enum": [
          "upper",
          "lower",
          "title",
          "camel",
          "pascal",
          "snake",
          "kebab"
        ]
      }
    },
    "required": [
      "text",
      "style"
    ]
  },
  "slugify": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    },
    "required": [
      "text"
    ]
  },
  "json_to_yaml": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "json": {
        "type": "string",
        "description": "JSON input as a string."
      }
    },
    "required": [
      "json"
    ]
  },
  "yaml_to_json": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "yaml": {
        "type": "string",
        "description": "YAML input."
      }
    },
    "required": [
      "yaml"
    ]
  },
  "csv_to_json": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "CSV input."
      },
      "delimiter": {
        "description": "Field delimiter (default \",\").",
        "type": "string"
      },
      "header": {
        "description": "First row is header (default true). If false, returns array of arrays.",
        "type": "boolean"
      }
    },
    "required": [
      "text"
    ]
  },
  "json_to_csv": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "json": {
        "type": "string",
        "description": "JSON array of objects, as a string."
      },
      "delimiter": {
        "description": "Field delimiter (default \",\").",
        "type": "string"
      }
    },
    "required": [
      "json"
    ]
  },
  "sql_beautify": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "sql": {
        "type": "string",
        "description": "SQL query."
      }
    },
    "required": [
      "sql"
    ]
  },
  "html_beautify": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "html": {
        "type": "string",
        "description": "HTML input."
      },
      "indent": {
        "description": "Indent size (default 2).",
        "type": "number"
      }
    },
    "required": [
      "html"
    ]
  },
  "xml_beautify": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "xml": {
        "type": "string",
        "description": "XML input."
      },
      "indent": {
        "description": "Indent size (default 2).",
        "type": "number"
      }
    },
    "required": [
      "xml"
    ]
  },
  "js_beautify": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "maxLength": 2000000,
        "description": "Source code to format or minify."
      },
      "mode": {
        "default": "beautify",
        "description": "beautify = pretty-print, minify = strip comments and whitespace.",
        "type": "string",
        "enum": [
          "beautify",
          "minify"
        ]
      },
      "language": {
        "default": "javascript",
        "description": "Language of the code. TypeScript gets generic and optional-marker fix-ups; JSX cannot be minified.",
        "type": "string",
        "enum": [
          "javascript",
          "typescript",
          "jsx"
        ]
      },
      "indent": {
        "default": 2,
        "description": "Spaces per indent level when beautifying (0 = tabs).",
        "type": "integer",
        "minimum": 0,
        "maximum": 8
      },
      "brace_style": {
        "default": "collapse",
        "description": "Brace placement when beautifying: collapse = K&R (same line), expand = Allman (own line).",
        "type": "string",
        "enum": [
          "collapse",
          "expand",
          "end-expand",
          "collapse,preserve-inline"
        ]
      },
      "keep_license": {
        "default": true,
        "description": "When minifying, keep /*! ... */ and @license comments.",
        "type": "boolean"
      }
    },
    "required": [
      "code"
    ]
  },
  "css_beautify": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "css": {
        "type": "string",
        "maxLength": 2000000,
        "description": "Stylesheet source."
      },
      "mode": {
        "default": "beautify",
        "description": "beautify = one declaration per line, minify = smallest output.",
        "type": "string",
        "enum": [
          "beautify",
          "minify"
        ]
      },
      "syntax": {
        "default": "css",
        "description": "Input syntax; scss and less also accept // line comments.",
        "type": "string",
        "enum": [
          "css",
          "scss",
          "less"
        ]
      },
      "sort": {
        "default": false,
        "description": "Sort declarations inside each rule alphabetically (vendor-prefixed copies first, override pairs kept in order).",
        "type": "boolean"
      },
      "indent": {
        "default": 2,
        "description": "Spaces per indent level when beautifying (0 = tabs).",
        "type": "integer",
        "minimum": 0,
        "maximum": 8
      }
    },
    "required": [
      "css"
    ]
  },
  "remove_duplicate_lines": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Multi-line text to deduplicate."
      },
      "trim": {
        "description": "Trim each line before comparing (default true).",
        "type": "boolean"
      },
      "caseInsensitive": {
        "description": "Compare case-insensitively (default false).",
        "type": "boolean"
      }
    },
    "required": [
      "text"
    ]
  },
  "lines_to_comma": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Multi-line input."
      },
      "separator": {
        "description": "Separator between items (default \", \").",
        "type": "string"
      },
      "quote": {
        "description": "Wrap each item in double quotes (default false).",
        "type": "boolean"
      }
    },
    "required": [
      "text"
    ]
  },
  "epoch_convert": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "value": {
        "type": "string",
        "description": "A number (as string) or an ISO 8601 date string."
      }
    },
    "required": [
      "value"
    ]
  },
  "cron_validate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "expression": {
        "type": "string",
        "description": "Cron expression, e.g. '*/15 * * * *'."
      }
    },
    "required": [
      "expression"
    ]
  },
  "regex_test": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "pattern": {
        "type": "string"
      },
      "flags": {
        "description": "e.g. \"gi\"",
        "type": "string"
      },
      "text": {
        "type": "string"
      }
    },
    "required": [
      "pattern",
      "text"
    ]
  },
  "number_base_convert": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "value": {
        "type": "string",
        "description": "The number. Accepts a sign, 0x/0o/0b prefixes, '_' separators and a fractional part, e.g. '255', '-42', '0xFF', '10.625'."
      },
      "from": {
        "description": "Base of the input, 2 to 36. Omit to read it from a 0x/0o/0b prefix, otherwise decimal.",
        "type": "integer",
        "minimum": 2,
        "maximum": 36
      },
      "to": {
        "description": "An extra target base besides 2, 8, 10 and 16.",
        "type": "integer",
        "minimum": 2,
        "maximum": 36
      },
      "width": {
        "description": "Bit width for the two's complement view (8, 16, 32, 64 or any 1-1024).",
        "type": "integer",
        "minimum": 1,
        "maximum": 1024
      },
      "inputIsPattern": {
        "description": "Read the input as a two's complement bit pattern of `width` bits, so FF at 8 bits is -1. Default false.",
        "type": "boolean"
      }
    },
    "required": [
      "value"
    ]
  },
  "http_status": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "A status code such as 429, a class such as 3xx, or search words such as 'redirect keep method'."
      },
      "includeUnofficial": {
        "description": "Include vendor codes such as nginx 499 and Cloudflare 522. Default true.",
        "type": "boolean"
      },
      "limit": {
        "description": "Maximum results to return. Default 20.",
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "query"
    ]
  },
  "mime_lookup": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "An extension (webp or .webp), a file name (report.docx, archive.tar.gz) or a MIME type (application/json, image/*)."
      }
    },
    "required": [
      "query"
    ]
  },
  "gitignore_generate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "templates": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Template ids or names, e.g. ['node', 'python', 'macos', 'vscode']."
      },
      "extra": {
        "description": "Extra lines to append, one pattern per line.",
        "type": "string"
      },
      "testPaths": {
        "description": "Repository-relative paths to check, e.g. ['.env', 'dist/']. End with / for a directory.",
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "templates"
    ]
  },
  "lorem_ipsum": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "count": {
        "type": "number",
        "minimum": 1,
        "maximum": 50,
        "description": "How many units to generate."
      },
      "unit": {
        "type": "string",
        "enum": [
          "words",
          "sentences",
          "paragraphs"
        ],
        "description": "Unit type."
      }
    },
    "required": [
      "count",
      "unit"
    ]
  },
  "password_generate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "length": {
        "description": "Password length (default 16).",
        "type": "number",
        "minimum": 4,
        "maximum": 256
      },
      "lowercase": {
        "description": "Include lowercase letters (default true).",
        "type": "boolean"
      },
      "uppercase": {
        "description": "Include uppercase letters (default true).",
        "type": "boolean"
      },
      "digits": {
        "description": "Include digits (default true).",
        "type": "boolean"
      },
      "symbols": {
        "description": "Include symbols !@#$%^&*()-_=+ (default false).",
        "type": "boolean"
      },
      "count": {
        "description": "How many passwords to generate (default 1).",
        "type": "number",
        "minimum": 1,
        "maximum": 50
      }
    }
  },
  "markdown_table": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "maxLength": 1000000,
        "description": "CSV, TSV or Markdown table text. The delimiter is detected automatically."
      },
      "align": {
        "default": "none",
        "description": "Alignment for every column (none keeps alignment from a Markdown input).",
        "type": "string",
        "enum": [
          "none",
          "left",
          "center",
          "right"
        ]
      },
      "pretty": {
        "default": true,
        "description": "Pad cells so the columns line up in plain text.",
        "type": "boolean"
      },
      "outer_pipes": {
        "default": true,
        "description": "Start and end each row with |.",
        "type": "boolean"
      },
      "bold_header": {
        "default": false,
        "description": "Wrap header cells in **bold**.",
        "type": "boolean"
      }
    },
    "required": [
      "text"
    ]
  },
  "word_count": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "The text to count."
      },
      "readingWpm": {
        "default": 238,
        "description": "Silent reading speed in words per minute (238 is the adult non-fiction average).",
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 2000
      },
      "speakingWpm": {
        "default": 150,
        "description": "Speaking speed in words per minute for the speech-time estimate.",
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1000
      },
      "topWords": {
        "default": 10,
        "description": "How many frequent words to return, stop words excluded. 0 to skip.",
        "type": "integer",
        "minimum": 0,
        "maximum": 50
      }
    },
    "required": [
      "text"
    ]
  },
  "tsv_parse": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "TSV input."
      },
      "header": {
        "description": "First row is header (default true).",
        "type": "boolean"
      }
    },
    "required": [
      "text"
    ]
  },
  "yaml_beautify": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "yaml": {
        "type": "string",
        "description": "YAML input."
      }
    },
    "required": [
      "yaml"
    ]
  },
  "escape_characters": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Input text."
      },
      "mode": {
        "type": "string",
        "enum": [
          "escape",
          "unescape"
        ],
        "description": "Direction."
      },
      "format": {
        "type": "string",
        "enum": [
          "json",
          "html",
          "xml",
          "js",
          "sql"
        ],
        "description": "Target format."
      }
    },
    "required": [
      "text",
      "mode",
      "format"
    ]
  },
  "find_duplicate_entries": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Multi-line text to scan."
      },
      "trim": {
        "description": "Trim each line before comparing (default true).",
        "type": "boolean"
      },
      "caseInsensitive": {
        "description": "Compare case-insensitively (default false).",
        "type": "boolean"
      }
    },
    "required": [
      "text"
    ]
  },
  "remove_extra_spaces": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Text to normalize."
      }
    },
    "required": [
      "text"
    ]
  },
  "remove_empty_lines": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Multi-line text."
      }
    },
    "required": [
      "text"
    ]
  },
  "comma_to_lines": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Delimited input."
      },
      "separator": {
        "description": "Delimiter to split on (default \",\").",
        "type": "string"
      },
      "trim": {
        "description": "Trim each item (default true).",
        "type": "boolean"
      }
    },
    "required": [
      "text"
    ]
  },
  "hash_compare": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "a": {
        "type": "string",
        "description": "First input."
      },
      "b": {
        "type": "string",
        "description": "Second input."
      },
      "algorithm": {
        "description": "Hash algorithm (default sha256).",
        "type": "string",
        "enum": [
          "md5",
          "sha1",
          "sha256",
          "sha384",
          "sha512"
        ]
      }
    },
    "required": [
      "a",
      "b"
    ]
  },
  "bcrypt_hash": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "password": {
        "type": "string",
        "minLength": 1,
        "description": "Password to hash."
      },
      "cost": {
        "description": "Bcrypt cost factor (4-12, default 10).",
        "type": "number",
        "minimum": 4,
        "maximum": 12
      }
    },
    "required": [
      "password"
    ]
  },
  "bcrypt_verify": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "password": {
        "type": "string",
        "description": "Plaintext password."
      },
      "hash": {
        "type": "string",
        "description": "Bcrypt hash to verify against."
