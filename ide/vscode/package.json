{
  "name": "redbison-tools",
  "displayName": "RedBison Tools",
  "description": "Format JSON, decode a JWT, hash a string, convert a timestamp and 96 more developer tools, on the selection, without leaving the editor. 89 run offline.",
  "version": "0.2.0",
  "publisher": "redbison",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/redbison-dev/redbison-tools.git",
    "directory": "ide/vscode"
  },
  "homepage": "https://redbison.dev",
  "bugs": {
    "url": "https://github.com/redbison-dev/redbison-tools/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "json",
    "base64",
    "jwt",
    "hash",
    "yaml",
    "csv",
    "sql",
    "uuid",
    "regex",
    "developer tools",
    "formatter",
    "offline"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "bunx @vscode/vsce package --no-dependencies",
    "publish": "bunx @vscode/vsce publish --no-dependencies",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test": "bun run compile-tests && node out/ide/vscode/src/test/runTest.js"
  },
